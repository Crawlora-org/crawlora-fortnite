    "/fortnite/ecosystem-metric": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns a native aggregate peak concurrent-user resource. Intervals are `day`, `hour`, and `minute`; minute buckets are ten minutes.",
        "operationId": "fortnite-ecosystem-metric",
        "parameters": [
          {
            "description": "Bucket size",
            "enum": [
              "day",
              "hour",
              "minute"
            ],
            "in": "query",
            "name": "interval",
            "required": true,
            "type": "string",
            "x-example": "day"
          },
          {
            "description": "Native metric path variant",
            "enum": [
              "in-client-peak-ccu",
              "in-match-peak-ccu"
            ],
            "in": "query",
            "name": "metric",
            "required": true,
            "type": "string",
            "x-example": "in-client-peak-ccu"
          },
          {
            "description": "Inclusive ISO-8601 start time, within seven days",
            "in": "query",
            "name": "from",
            "type": "string"
          },
          {
            "description": "Exclusive ISO-8601 end time",
            "in": "query",
            "name": "to",
            "type": "string"
          }
